---
import "../styles/global.css";
const services = [
  {
    title: "Invitation Cards",
    description: "Elegant invitations designed and printed for weddings, celebrations, and special occasions.",
    icon: "✦",
  },
  {
    title: "Posters",
    description: "Bold, high-impact posters for events, promotions, announcements, and displays.",
    icon: "▣",
  },
  {
    title: "Flyers",
    description: "Professional flyers that communicate your message clearly and make an impression.",
    icon: "◈",
  },
  {
    title: "Visiting / Business Cards",
    description: "Clean, professional business cards that represent you and your brand with confidence.",
    icon: "▤",
  },
  {
    title: "Banners",
    description: "Large-format banners created for storefronts, events, campaigns, and promotions.",
    icon: "▥",
  },
  {
    title: "Brochures",
    description: "Well-structured brochures that present your business, products, or services beautifully.",
    icon: "▧",
  },
  {
    title: "Letterheads & Envelopes",
    description: "Professional stationery that gives your business correspondence a polished identity.",
    icon: "✉",
  },
  {
    title: "Stickers",
    description: "Custom stickers for branding, packaging, labels, promotions, and creative projects.",
    icon: "●",
  },
  {
    title: "Custom Printing",
    description: "Printing solutions tailored to your specific design, format, and business needs.",
    icon: "✷",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Umerzai Printing Press — professional printing services in Umerzai Bazar."
    />
    <title>Umerzai Printing Press | Umerzai Bazar</title>
  </head>

  <body class="bg-slate-950 text-slate-100 antialiased">
    <header class="absolute inset-x-0 top-0 z-50">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8">
        <a href="/" class="flex items-center gap-3" aria-label="Umerzai Printing Press home">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-lg font-bold shadow-lg shadow-blue-950/40"
          >
            U
          </span>
          <span class="text-sm font-bold tracking-tight sm:text-base">
            Umerzai Printing Press
          </span>
        </a>

        <a
          href="#services"
          class="hidden rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-white backdrop-blur transition hover:border-white/25 hover:bg-white/10 sm:inline-flex"
        >
          Our Services
        </a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="relative isolate overflow-hidden">
        <div
          class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_75%_20%,rgba(37,99,235,0.22),transparent_34%),radial-gradient(circle_at_15%_75%,rgba(14,165,233,0.12),transparent_28%)]"
        ></div>
        <div class="absolute inset-0 -z-10 bg-slate-950"></div>

        <div
          class="mx-auto grid min-h-[720px] max-w-7xl items-center gap-14 px-6 pb-20 pt-32 lg:grid-cols-[1.08fr_.92fr] lg:px-8 lg:pb-24 lg:pt-36"
        >
          <div class="max-w-3xl">
            <div
              class="mb-7 inline-flex items-center gap-2 rounded-full border border-blue-400/20 bg-blue-500/10 px-4 py-2 text-sm font-medium text-blue-300"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span>
              Printing in Umerzai Bazar
            </div>

            <h1
              class="text-5xl font-black leading-[1.02] tracking-[-0.04em] text-white sm:text-6xl lg:text-7xl"
            >
              Bring your ideas
              <span class="block text-blue-400">to print.</span>
            </h1>

            <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-400 sm:text-xl">
              Professional printing for businesses, events, and everyday needs.
              From eye-catching banners to polished business cards, we turn your
              designs into quality printed materials.
            </p>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a
                href="#services"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-xl shadow-blue-950/30 transition hover:bg-blue-500"
              >
                Explore Services
                <span aria-hidden="true">→</span>
              </a>
              <a
                href="#about"
                class="inline-flex items-center justify-center rounded-full border border-white/15 px-6 py-3.5 text-sm font-semibold text-slate-200 transition hover:border-white/25 hover:bg-white/5"
              >
                About Us
              </a>
            </div>
          </div>

          <div class="relative mx-auto w-full max-w-md lg:max-w-none">
            <div
              class="absolute -inset-8 -z-10 rounded-full bg-blue-600/10 blur-3xl"
            ></div>

            <div
              class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04] p-4 shadow-2xl shadow-black/30 backdrop-blur"
            >
              <div
                class="rounded-[1.5rem] border border-white/10 bg-gradient-to-br from-blue-600 via-blue-700 to-slate-900 p-8 sm:p-10"
              >
                <div class="flex items-start justify-between">
                  <div
                    class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-2xl font-black text-blue-700 shadow-lg"
                  >
                    U
                  </div>
                  <span class="rounded-full bg-white/10 px-3 py-1.5 text-xs font-medium text-blue-100">
                    EST. Umerzai Bazar
                  </span>
                </div>

                <div class="mt-24">
                  <p class="text-sm font-medium uppercase tracking-[0.2em] text-blue-100/70">
                    Quality Printing
                  </p>
                  <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
                    Your vision.<br />
                    Our print.
                  </h2>
                </div>

                <div class="mt-10 grid grid-cols-3 gap-2">
                  <div class="h-1.5 rounded-full bg-white"></div>
                  <div class="h-1.5 rounded-full bg-blue-300/50"></div>
                  <div class="h-1.5 rounded-full bg-blue-300/20"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="border-y border-white/5 bg-white/[0.02]">
          <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-3 px-6 py-5 text-sm text-slate-500 lg:px-8">
            <span class="font-medium text-slate-400">Umerzai Printing Press</span>
            <span class="hidden h-1 w-1 rounded-full bg-slate-700 sm:block"></span>
            <span>Umerzai Bazar</span>
            <span class="hidden h-1 w-1 rounded-full bg-slate-700 sm:block"></span>
            <span>Professional Printing Services</span>
          </div>
        </div>
      </section>

      <!-- Services -->
      <section id="services" class="bg-white py-24 text-slate-900 sm:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="max-w-2xl">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-600">
              What we print
            </p>
            <h2 class="mt-4 text-4xl font-black tracking-[-0.03em] sm:text-5xl">
              Printing for every purpose.
            </h2>
            <p class="mt-5 text-lg leading-8 text-slate-600">
              Choose from our core printing services or bring us your own custom
              project. We focus on clean results and professional presentation.
            </p>
          </div>

          <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {services.map((service, index) => (
              <article
                class="group rounded-3xl border border-slate-200 bg-slate-50 p-7 transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:bg-white hover:shadow-xl hover:shadow-slate-200/70"
              >
                <div
                  class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-lg font-bold text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white"
                >
                  {service.icon}
                </div>

                <div class="mt-7 flex items-start justify-between gap-4">
                  <h3 class="text-xl font-bold tracking-tight">
                    {service.title}
                  </h3>
                  <span class="pt-1 text-xs font-semibold text-slate-300">
                    0{index + 1}
                  </span>
                </div>

                <p class="mt-3 text-sm leading-6 text-slate-600">
                  {service.description}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- About -->
      <section id="about" class="relative overflow-hidden bg-slate-900 py-24 sm:py-28">
        <div
          class="absolute right-0 top-0 h-96 w-96 rounded-full bg-blue-600/10 blur-3xl"
        ></div>

        <div class="relative mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-2 lg:items-center lg:px-8">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-400">
              About Umerzai Printing Press
            </p>
            <h2 class="mt-4 text-4xl font-black tracking-[-0.03em] text-white sm:text-5xl">
             

      <!-- CTA -->
      <section class="bg-blue-600"><!-- About Us --><!-- Contact Us -->
<section id="contact" class="bg-slate-900 py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-400">
        Contact Us
      </p>

      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Let's talk about your printing needs.
      </h2>

      <p class="mt-4 text-lg text-slate-300">
        Get in touch with Umerzai Printing Press in Umerzai Bazar.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-3">
      <a
        href="tel:+923015748382"
        class="rounded-2xl border border-white/10 bg-slate-800 p-6 text-center transition hover:border-blue-400"
      >
        <div class="text-3xl">📞</div>
        <h3 class="mt-4 font-bold text-white">Call Us</h3>
        <p class="mt-2 text-slate-300">0301 5748382</p>
      </a>

      <a
        href="https://wa.me/923015748382"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-2xl border border-white/10 bg-slate-800 p-6 text-center transition hover:border-blue-400"
      >
        <div class="text-3xl">💬</div>
        <h3 class="mt-4 font-bold text-white">WhatsApp</h3>
        <p class="mt-2 text-slate-300">0301 5748382</p>
      </a>

      <a
        href="mailto:abc@gmail.com"
        class="rounded-2xl border border-white/10 bg-slate-800 p-6 text-center transition hover:border-blue-400"
      >
        <div class="text-3xl">✉️</div>
        <h3 class="mt-4 font-bold text-white">Email</h3>
        <p class="mt-2 text-slate-300">abc@gmail.com</p>
      </a>
    </div>

    <div class="mt-8 text-center text-slate-300">
      📍 Umerzai Bazar
    </div>
  </div>
</section>
<section class="bg-slate-900 py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-blue-400">
          About Us
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Your local printing partner in Umerzai Bazar.
        </h2>

        <p class="mt-6 text-lg leading-8 text-slate-300">
          Umerzai Printing Press provides printing services for businesses,
          events, organizations, and everyday needs.
        </p>

        <p class="mt-4 leading-7 text-slate-400">
          From invitation cards and business cards to posters, banners,
          brochures, stickers, and custom printing, we help turn your ideas
          into professional printed materials.
        </p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-800 p-8">
        <div class="text-5xl">🖨️</div>

        <h3 class="mt-6 text-2xl font-bold text-white">
          Quality Printing
        </h3>

        <p class="mt-3 leading-7 text-slate-300">
          Serving customers in and around Umerzai Bazar with a range of
          printing solutions.
        </p>

        <div class="mt-6 flex items-center gap-3 text-sm font-semibold text-blue-400">
          <span>📍</span>
          <span>Umerzai Bazar</span>
        </div>
      </div>

    </div>
  </div>
</section>
        <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-20">
          <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-100">
                Have a project in mind?
              </p>
              <h2 class="mt-3 max-w-2xl text-3xl font-black tracking-tight text-white sm:text-4xl">
                Let's put your ideas on paper.
              </h2>
            </div>

            <a
              href="#services"
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-bold text-blue-700 shadow-lg transition hover:bg-blue-50"
            >
              View Our Services
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-slate-950">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between lg:px-8"
      >
        <div class="font-semibold text-slate-300">Umerzai Printing Press</div>
        <div>Umerzai Bazar</div>
      </div>
    </footer>
  </body>
</html>
